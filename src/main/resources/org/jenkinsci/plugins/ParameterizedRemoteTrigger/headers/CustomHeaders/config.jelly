<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:entry title="${%Headers}">
        <f:repeatableProperty field="headers" minimum="1">
            <f:block>
                <div align="right">
                    <f:repeatableDeleteButton />
                </div>
            </f:block>
        </f:repeatableProperty>
    </f:entry>
</j:jelly>
